#!/bin/bash
# Quick command to check dataset status

kubectl run dataset-status-check -n budeval --rm -i --restart=Never --image=busybox -- sh -c '
if [ -f /data/dataset_initialized ]; then
  echo "✅ Dataset is INITIALIZED"
  echo "Initialized at: $(cat /data/dataset_initialized)"
  echo "Size: $(du -sh /data/ | cut -f1)"
else
  echo "❌ Dataset NOT initialized"
fi
' --overrides='{"spec":{"containers":[{"name":"dataset-status-check","volumeMounts":[{"name":"data","mountPath":"/data"}]}],"volumes":[{"name":"data","persistentVolumeClaim":{"claimName":"eval-datasets-pvc"}}]}}'